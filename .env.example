MONELIORA_ADMIN_TOKEN=replace-with-a-random-64-character-secret
MONELIORA_DB=./data/moneliora.db
MONELIORA_ORIGIN=http://127.0.0.1:8000
MONELIORA_SECURE_COOKIES=false

# PayPal sandbox by default; configure an actual plan in PayPal Business Developer.
MONELIORA_PAYPAL_MODE=sandbox
MONELIORA_PAYPAL_CLIENT_ID=
MONELIORA_PAYPAL_CLIENT_SECRET=
MONELIORA_PAYPAL_WEBHOOK_ID=
MONELIORA_PAYPAL_PREMIUM_PLAN_ID=
MONELIORA_PAYPAL_PRO_PLAN_ID=
MONELIORA_PUBLIC_URL=http://127.0.0.1:8000

# Pilot interest intake only; never enables payments. Closed by default.
MONELIORA_PILOT_ENABLED=false
MONELIORA_PILOT_ONLY=false
MONELIORA_SELLER_NAME=
MONELIORA_PRIVACY_URL=
MONELIORA_TERMS_URL=
MONELIORA_LEGAL_URL=
